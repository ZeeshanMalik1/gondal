# Public site URL — used for canonical URLs, Open Graph and the sitemap.
# Set this to the real production domain when deploying.
NEXT_PUBLIC_SITE_URL=https://gondalgroup.example.com

# Optional: contact form backend.
# When set, POSTs from the contact forms are forwarded to this webhook/endpoint.
# When unset, the forms validate client-side and show an honest "not connected" notice
# with a mailto fallback — they never pretend messages were sent.
CONTACT_WEBHOOK_URL=